# Database (PostgreSQL on Neon)
# Leave commented for local SQLite development
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Super Admin Key
# Known ONLY to the developer (you). Used for setup, settings changes, password reset.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SUPER_ADMIN_KEY=change_this_to_a_random_64_char_hex_string

# Railway start command (for reference):
# uvicorn backend:app --host 0.0.0.0 --port 8000
